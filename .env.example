# Shared configuration for Cartographer's backend and frontend dev servers.
# Copy this file to .env (gitignored) and adjust values as needed.
# This file is the single source of truth for these values — both
# src/common/backend/config.py and src/main/frontend/vite.config.ts read it.

CARTOGRAPHER_BACKEND_PORT=5000
CARTOGRAPHER_FRONTEND_PORT=5173

# Chrome DevTools Protocol port used only by the VS Code F5 dev loop, so the
# "Edge: Cartographer Frontend" debug session can attach to a browser window
# .vscode/scripts/start-edge-debug-session.ps1 launches and owns itself. Not
# read dynamically by that script or by launch.json — both hardcode this
# value like the two ports above; documented here for discoverability only.
CARTOGRAPHER_EDGE_DEBUG_PORT=9222
